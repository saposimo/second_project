# Stage world file – Second Robotics Project
# ────────────────────────────────────────────────────────────────────
# IMPORTANT: after Task 1, update the floorplan size to match your map:
#   size [W H 0.5]  where W = map_width_px * resolution
#                         H = map_height_px * resolution
# The bitmap path is relative to this file (../map/map.png).
# ────────────────────────────────────────────────────────────────────

resolution 0.05
interval_sim 100

# ── Floorplan model used by Stage bitmap maps ───────────────────────
define floorplan model
(
  color "gray30"
  boundary 1
  gui_nose 0
  gui_grid 0
  gui_move 0
  gui_outline 0
  gripper_return 0
  fiducial_return 0
  ranger_return 1
)

# ── Robot model: AgileX Scout Mini Omnidirectional ───────────────────
define omni_laser ranger
(
  sensor
  (
    pose [ 0.0 0.0 0.0 0.0 ]
    size [ 0.1 0.1 0.1 ]
    range [ 0.05 20.0 ]
    fov 360.0
    samples 720
  )
  color "black"
  size [ 0.05 0.05 0.05 ]
)

define omni_robot position
(
  # AgileX Scout Mini Omnidirectional real footprint (AgileX datasheet):
  #   length 612 mm x width 580 mm x height 245 mm
  size [ 0.612 0.580 0.245 ]
  origin [ 0.0 0.0 0.0 0.0 ]
  drive "omni"                 # omnidirectional kinematics

  omni_laser(pose [ 0.0 0.0 0.2 0.0 ])

  color "red"
  localization "odom"
  odom_error [ 0.0 0.0 0.0 0.0 ]
)

# ── Environment (map) ────────────────────────────────────────────────
floorplan
(
  name "map"
  bitmap "../map/map.png"
  size [ 30.7 17.45 0.5 ]
  # Centre = map.yaml origin + half-size:  (-6.82 + 15.35, -12.7 + 8.725) = (8.53, -3.975)
  # This makes the Stage world frame coincide with the nav2 'map' frame.
  pose [ 8.53 -3.975 0.0 0.0 ]
)

# ── Simulation window ────────────────────────────────────────────────
window
(
  size [ 1024 768 ]
  center [ 8.53 -3.975 ]
  rotate [ 0.0 0.0 ]
  scale 20.0
)

# ── Robot instance (start pose matches the first CSV goal) ───────────
omni_robot
(
  name "robot"
  pose [ 1.6 -4.4 0.0 0.0 ]   # first goal position as start pose
)
