Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Stage LaserScan
      Size (m): 0.04
      Color: 255; 0; 0
      Topic:
        Value: /base_scan
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: true
    - Alpha: 1
      Class: nav2_rviz_plugins/ParticleCloud
      Color: 0; 180; 0
      Enabled: true
      Max Arrow Length: 0.3
      Min Arrow Length: 0.02
      Name: Particle Cloud (AMCL)
      Shape: Arrow (Flat)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /particle_cloud
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Global Path
      Topic:
        Value: /plan
        Reliability Policy: Reliable
      Color: 0; 128; 255
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Local Path
      Topic:
        Value: /local_plan
        Reliability Policy: Reliable
      Color: 0; 255; 128
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Enabled: true
      Name: All Goals (CSV)
      Shape: Arrow (Flat)
      Color: 255; 170; 0
      Topic:
        Value: /goals
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Current Goal
      Color: 255; 25; 0
      Topic:
        Value: /current_goal
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Enabled: true
      Name: Robot Pose
      Topic:
        Value: /amcl_pose
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 22
      X: 8.5
      Y: -4.0
Window Geometry:
  Height: 900
  Width: 1200
  X: 0
  Y: 0
