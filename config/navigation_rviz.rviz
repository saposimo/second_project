Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
    - Alpha: 0.3
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Enabled: true
      Name: Local Costmap
      Topic:
        Value: /local_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan
      Size (m): 0.02
      Color: 255; 0; 0
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Enabled: true
      Name: Particle Cloud (AMCL)
      Topic:
        Value: /particle_cloud
        Reliability Policy: Best Effort
      Color: 0; 255; 0
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Global Path
      Topic:
        Value: /plan
        Reliability Policy: Reliable
      Color: 0; 128; 255
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Local Path
      Topic:
        Value: /local_plan
        Reliability Policy: Reliable
      Color: 0; 255; 128
      Value: true
    - Class: rviz_default_plugins/PoseStamped
      Enabled: true
      Name: Current Goal
      Topic:
        Value: /goal_pose
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Robot Pose
      Topic:
        Value: /amcl_pose
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 10
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1200
  X: 0
  Y: 0
